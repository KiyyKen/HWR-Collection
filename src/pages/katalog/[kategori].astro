---
import type { GetStaticPaths } from 'astro';

import Base from '../../layouts/Base.astro';
import CatalogView from '../../components/catalog/CatalogView.astro';
import { abs } from '../../lib/seo';
import { categories, getCategory, type CategoryId } from '../../data/categories';
import { getProducts, countByCategory } from '../../lib/products';

/**
 * Tiap kategori punya halaman statisnya sendiri.
 *
 * Bukan sekadar query string: URL-nya bisa dibagikan ke grup WhatsApp,
 * di-bookmark reseller, dan di-index mesin pencari untuk pencarian seperti
 * "grosir celana cargo anak". Filter kategori juga jadi bekerja tanpa
 * JavaScript sama sekali.
 */
export const getStaticPaths = (() =>
  categories.map((category) => ({
    params: { kategori: category.id },
  }))) satisfies GetStaticPaths;

const kategori = Astro.params.kategori as CategoryId;
const category = getCategory(kategori);

const all = await getProducts();
const products = all.filter((p) => p.data.category === kategori);
const counts = await countByCategory();

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Beranda', item: abs() },
    { '@type': 'ListItem', position: 2, name: 'Katalog', item: abs('katalog') },
    {
      '@type': 'ListItem',
      position: 3,
      name: category.title,
      item: abs('katalog', category.id),
    },
  ],
};
---

<Base
  title={`${category.title} — Katalog`}
  description={`${category.blurb} Harga per lusin, minimum pemesanan 1 lusin, kirim ke seluruh Indonesia.`}
  schema={breadcrumb}
>
  <CatalogView
    heading={category.title}
    intro={category.blurb}
    products={products}
    activeCategory={kategori}
    counts={counts}
    total={all.length}
  />
</Base>
