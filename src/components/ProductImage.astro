---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * Satu-satunya tempat foto produk di-resolve.
 *
 * Dua sumber, satu keluaran:
 *
 *   CMS   → `data.image` berisi URL CDN 4:5 beserta dimensinya.
 *   Lokal → file di src/assets/products/<id>.<ext>.
 *
 * Keduanya melewati `astro:assets` yang sama, jadi markup, srcset, dan isi
 * dist/ berbentuk sama persis — termasuk untuk foto dari CMS, yang diunduh
 * dan dioptimalkan saat build, bukan diminta browser pengunjung ke CDN
 * pihak ketiga.
 */
const files = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/products/*.{webp,avif,jpg,jpeg,png}',
  { eager: true },
);

const byId = new Map<string, ImageMetadata>(
  Object.entries(files).map(([path, mod]) => [
    path.split('/').pop()!.replace(/\.\w+$/, ''),
    mod.default,
  ]),
);

interface Props {
  /** id produk, sama dengan nama file gambar untuk sumber lokal. */
  id: string;
  alt: string;
  sizes: string;
  /** Foto dari CMS. Kalau ada, ini yang dipakai. */
  image?: { url: string; width: number; height: number; alt: string | null };
  /** Lebar yang dibuatkan srcset-nya. */
  widths?: number[];
  priority?: boolean;
  class?: string;
}

const {
  id,
  alt,
  sizes,
  image,
  widths = [320, 480, 640, 960, 1280],
  priority = false,
  class: className,
} = Astro.props;

const lokal = image ? undefined : byId.get(id);
if (!image && !lokal) {
  throw new Error(
    `Foto produk tidak ditemukan untuk "${id}". Jalankan "npm run gen:photos", taruh file di src/assets/products/${id}.webp, atau unggah fotonya di Sanity Studio.`,
  );
}

/*
  Alt dari CMS menang kalau admin mengisinya: dia yang melihat fotonya.
  Kalau kosong, dipakai alt yang dirangkai dari data produk — tidak pernah
  ada gambar tanpa alt.
*/
const teksAlt = image?.alt ?? alt;

/*
  Dua cabang, bukan satu `<Image>` dengan props kondisional: tipe Astro
  untuk gambar lokal dan gambar remote memang berbeda, dan gambar remote
  WAJIB membawa dimensinya sendiri — Astro tidak bisa menebaknya tanpa
  mengunduh dulu. Tanpa dimensi itu ruangnya tidak tercadangkan dan halaman
  bergeser saat gambar masuk.
*/
const umum = {
  alt: teksAlt,
  widths,
  sizes,
  loading: priority ? ('eager' as const) : ('lazy' as const),
  fetchpriority: priority ? ('high' as const) : ('auto' as const),
  decoding: priority ? ('sync' as const) : ('async' as const),
};

const kelas = ['h-full w-full object-cover', className];
---

{
  image ? (
    <Image src={image.url} width={image.width} height={image.height} {...umum} class:list={kelas} />
  ) : (
    <Image src={lokal!} {...umum} class:list={kelas} />
  )
}
