---
import Wordmark from './Wordmark.astro';
import { site, isPlaceholder } from '../config/site';
import { categories } from '../data/categories';
import { storeEmail, storePhone } from '../lib/location';
import { whatsappDisplay } from '../lib/whatsapp';

const year = new Date().getFullYear();

const menu = [
  { href: '/katalog', label: 'Semua produk' },
  { href: '/#cara-pesan', label: 'Cara pesan' },
  { href: '/#lokasi', label: 'Lokasi toko' },
];

/**
 * WhatsApp dan Instagram tetap tampil walau belum diisi — keduanya jalur
 * kontak yang orang cari di footer, jadi penandanya lebih jujur daripada
 * baris yang hilang. Telepon dan email hanya muncul kalau memang ada.
 */
const contactRows: { label: string; value: string | null }[] = [
  { label: 'WhatsApp', value: whatsappDisplay() },
  { label: 'Instagram', value: site.social.instagram },
  ...(storePhone() ? [{ label: 'Telepon', value: storePhone() }] : []),
  ...(storeEmail() ? [{ label: 'Email', value: storeEmail() }] : []),
];
---

<footer class="bg-tinta text-kertas">
  <div class="wrap border-t border-kabut/25 py-12 md:py-14">
    <div class="grid gap-10 md:grid-cols-12 md:gap-8">
      <div class="md:col-span-4">
        <Wordmark size="lg" ground="gelap" />
        <p class="t-body mt-3 text-kabut">{site.tagline}</p>
      </div>

      <nav class="md:col-span-3" aria-label="Menu">
        <h2 class="t-produk">Menu</h2>
        <ul class="mt-1">
          {
            menu.map((item) => (
              <li>
                <a href={item.href} class="t-meta inline-flex min-h-11 items-center text-kabut underline-offset-4 hover:text-kertas hover:underline">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav class="md:col-span-2" aria-label="Kategori produk">
        <h2 class="t-produk">Kategori</h2>
        <ul class="mt-1">
          {
            categories.map((category) => (
              <li>
                <a
                  href={`/katalog/${category.id}`}
                  class="t-meta inline-flex min-h-11 items-center text-kabut underline-offset-4 hover:text-kertas hover:underline"
                >
                  {category.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="md:col-span-3">
        <h2 class="t-produk">Kontak</h2>
        <dl class="mt-3 space-y-2">
          {
            contactRows.map((row) => (
              <div>
                <dt class="sr-only">{row.label}</dt>
                <dd class="t-meta text-kabut">
                  {row.label}:{' '}
                  {isPlaceholder(row.value) ? (
                    <span class="italic">menunggu data</span>
                  ) : (
                    row.value
                  )}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>

    <p class="t-meta mt-12 border-t border-kabut/25 pt-6 text-kabut">
      © {year} {site.name}
    </p>
  </div>
</footer>
